{
  "name": "Asset",
  "type": "object",
  "properties": {
    "asset_id": {
      "type": "string",
      "description": "Unique asset ID (auto-generated)"
    },
    "name": {
      "type": "string",
      "description": "Asset name"
    },
    "category": {
      "type": "string",
      "enum": [
        "laptop",
        "desktop",
        "mobile",
        "tablet",
        "monitor",
        "printer",
        "furniture",
        "software",
        "networking",
        "other"
      ],
      "description": "Asset category"
    },
    "serial_number": {
      "type": "string"
    },
    "barcode": {
      "type": "string",
      "description": "Barcode value printed on the asset label \u2014 scanned to open this asset"
    },
    "image_url": {
      "type": "string",
      "description": "Asset image"
    },
    "purchase_date": {
      "type": "string",
      "format": "date"
    },
    "purchase_cost": {
      "type": "number"
    },
    "vendor_name": {
      "type": "string"
    },
    "vendor_contact": {
      "type": "string"
    },
    "warranty_months": {
      "type": "number",
      "description": "Warranty period in months"
    },
    "warranty_expiry": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "assigned",
        "in_repair",
        "retired",
        "lost"
      ],
      "default": "available"
    },
    "location": {
      "type": "string"
    },
    "assigned_to_email": {
      "type": "string"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "assigned_date": {
      "type": "string",
      "format": "date"
    },
    "depreciation_method": {
      "type": "string",
      "enum": [
        "straight_line",
        "reducing_balance"
      ],
      "default": "straight_line"
    },
    "useful_life_years": {
      "type": "number",
      "default": 5
    },
    "salvage_value": {
      "type": "number",
      "default": 0
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Invoice, warranty card URLs"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {}
  }
}