{
  "name": "DesignationPermission",
  "type": "object",
  "properties": {
    "designation_name": {
      "type": "string",
      "description": "Designation name \u2014 case-insensitive match key against Employee.designation"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of permission keys from PERMISSIONS config that this designation grants",
      "default": []
    },
    "is_system": {
      "type": "boolean",
      "default": false,
      "description": "Protects seed rows (HR Head, Employee, etc.) from deletion"
    },
    "display_order": {
      "type": "number",
      "default": 99,
      "description": "Sort order for table display"
    }
  },
  "required": [
    "designation_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}